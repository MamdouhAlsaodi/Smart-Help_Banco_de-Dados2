{
  "name": "smarthelp-banco-dados",
  "version": "1.0.0",
  "private": true,
  "description": "MVP de Helpdesk para Banco de Dados II: PostgreSQL, Docker, Node.js e Prisma ORM.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node src/seed.js",
    "demo": "node src/demo.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "prisma": "^6.16.1"
  }
}
