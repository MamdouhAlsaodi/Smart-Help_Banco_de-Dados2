# Copie para .env (ignorado pelo Git) e escolha senhas locais diferentes.
# Valores vazios impedem o Docker Compose de iniciar sem credenciais.
PORT=3000
NODE_ENV=development

POSTGRES_USER=smarthelp_user
POSTGRES_PASSWORD=
POSTGRES_DB=smarthelp
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@smarthelp.dev
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Para npm/Prisma executado no host, use o mesmo usuário, senha, banco e porta.
# Formato: postgresql://USUARIO:SENHA@127.0.0.1:5432/BANCO?schema=public
# Codifique caracteres especiais da senha na URL (percent-encoding).
DATABASE_URL=
